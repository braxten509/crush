      "type": "text",
      "data": {
       "text": "Step 21. Charges go through the ledger first and the card network second. When the network times out, the ledger entry stays open until the reconciler closes it about five minutes later."
      }
     },
     {
      "type": "finish",
      "data": {
       "reason": "end_turn",
       "time": 1792410120
      }
     }
