#!/usr/bin/env python3
"""Stands in for the AI tool CLIs (claude, codex, grok, opencode, agy) in
tests. It is reached through symlinks named after each tool, records how it
was called in $FAKE_TOOL_LOG, and answers with a minimal canned reply."""
import json, os, sys, time

tool = os.path.basename(sys.argv[0])
log = os.environ.get("FAKE_TOOL_LOG")
if log:
    with open(log, "a") as f:
        f.write(json.dumps({"tool": tool, "args": sys.argv[1:], "cwd": os.getcwd(), "at": time.time()}) + "\n")
if "--version" in sys.argv[1:]:
    print(f"{tool} 0.0.0-fake")
    sys.exit(0)
# Later phases teach this script each tool's real reply format.
print(json.dumps({"type": "result", "subtype": "success", "result": f"fake {tool} reply", "is_error": False}))
