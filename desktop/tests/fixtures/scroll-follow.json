    "parts": [
     {
      "type": "text",
      "data": {
       "text": "Step 22. Webhooks are signed with the merchant secret and retried with backoff: one second, then four, then sixteen, up to eight tries. A delivery that still fails lands in the dead-letter table."
      }
     },
     {
      "type": "finish",
      "data": {
       "reason": "end_turn",
       "time": 1792410140
      }
