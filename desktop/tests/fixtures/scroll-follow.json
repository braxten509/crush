    "role": "assistant",
    "session_id": "1f0c6a2e-5b7d-4c11-9e3a-7a5d2b8c4e11",
    "parts": [
     {
      "type": "text",
      "data": {
       "text": "Step 3. The idempotency keys live for twenty-four hours. A repeated key with a different body answers 409 and the original charge stays untouched. The retry rules are in the [payments guide](https://example.com/payments-guide)."
      }
     },
     {
      "type": "finish",
      "data": {
       "reason": "end_turn",
       "time": 1792409760
      }
     }
    ],
    "model": "haiku",
    "provider": "claude-code",
    "created_at": 1792409760,
    "updated_at": 1792409760
   },
